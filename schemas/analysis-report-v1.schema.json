{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulncheck.dev/schemas/analysis-report-v1.schema.json",
  "title": "vulncheck.dev AnalysisReport v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assurance", "generated_at", "provenance", "capability_report", "version", "reachability", "rules", "integrity", "freshness", "diagnostics"],
  "properties": {
    "schema_version": {"const": "v1"},
    "assurance": {"enum": ["module-view", "project-evidence"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "capability_report": {"$ref": "#/$defs/capabilityReport"},
    "version": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["affected", "not-affected", "unknown"]}}},
    "reachability": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["reachable", "no-static-path-found", "inconclusive"]}, "trace": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/traceStep"}}}, "allOf": [{"if": {"properties": {"status": {"const": "reachable"}}}, "then": {"required": ["trace"], "properties": {"trace": {"minItems": 1}}}}]},
    "rules": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["finding", "suppressed-finding", "no-finding", "not-analyzed"]}}},
    "integrity": {"$ref": "#/$defs/integrity"},
    "freshness": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["current", "stale", "unknown"]}}},
    "diagnostics": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "$defs": {
    "digest": {"type": "string", "minLength": 1, "maxLength": 256},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["go_toolchain", "build_profile", "dependency", "vulnerability_database", "analyzer_release"],
      "properties": {
        "go_toolchain": {"type": "object", "additionalProperties": false, "required": ["version", "digest"], "properties": {"version": {"type": "string", "minLength": 1, "maxLength": 128}, "digest": {"$ref": "#/$defs/digest"}}},
        "build_profile": {"type": "object", "additionalProperties": false, "required": ["goos", "goarch", "build_tags", "cgo_policy"], "properties": {"goos": {"type": "string", "minLength": 1, "maxLength": 64}, "goarch": {"type": "string", "minLength": 1, "maxLength": 64}, "build_tags": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 128}}, "cgo_policy": {"type": "string", "minLength": 1, "maxLength": 32}}},
        "dependency": {"type": "object", "additionalProperties": false, "required": ["source", "digest"], "properties": {"source": {"type": "string", "minLength": 1, "maxLength": 2048}, "digest": {"$ref": "#/$defs/digest"}}},
        "vulnerability_database": {"type": "object", "additionalProperties": false, "required": ["revision", "digest"], "properties": {"revision": {"type": "string", "minLength": 1, "maxLength": 256}, "digest": {"$ref": "#/$defs/digest"}}},
        "analyzer_release": {"type": "object", "additionalProperties": false, "required": ["digest"], "properties": {"digest": {"$ref": "#/$defs/digest"}}}
      }
    },
    "capabilityReport": {"type": "object", "additionalProperties": false, "required": ["schema_version", "observed_at", "selected_profile", "selected_fallback", "features"], "properties": {"schema_version": {"const": "v1"}, "observed_at": {"type": "string", "format": "date-time"}, "selected_profile": {"type": "string", "minLength": 1, "maxLength": 128}, "selected_fallback": {"type": "string", "minLength": 1, "maxLength": 128}, "features": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["name", "available", "detail"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 128}, "available": {"type": "boolean"}, "detail": {"type": "string", "minLength": 1, "maxLength": 256}}}}}},
    "traceStep": {"type": "object", "additionalProperties": false, "required": ["package", "symbol"], "properties": {"package": {"type": "string", "minLength": 1, "maxLength": 1024}, "symbol": {"type": "string", "minLength": 1, "maxLength": 1024}}},
    "integrity": {"type": "object", "additionalProperties": false, "required": ["status", "artifact_checks_passed", "module_checks_passed"], "properties": {"status": {"enum": ["verified", "unverified", "failed"]}, "artifact_checks_passed": {"type": "boolean"}, "module_checks_passed": {"type": "boolean"}}, "allOf": [{"if": {"properties": {"status": {"const": "verified"}}}, "then": {"properties": {"artifact_checks_passed": {"const": true}, "module_checks_passed": {"const": true}}}}]},
    "diagnostic": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string", "minLength": 1, "maxLength": 128}, "message": {"type": "string", "minLength": 1, "maxLength": 2048}}}
  }
}
